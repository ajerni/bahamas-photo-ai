# Loaded by backend/app/core/config.py — run uvicorn from the repo root.
# Every key also works with a PMM_ prefix; the three OpenRouter ones accept both.

# --- Model (required) ---
OPENROUTER_API_KEY=
OPENROUTER_MODEL=google/gemini-3.7-flash
OPENROUTER_BASE_URL=https://openrouter.ai/api/v1

# --- Storage ---
PMM_DATABASE_URL=sqlite:///backend/local_data/private_memory_map.db
PMM_UPLOAD_DIR=backend/local_data/uploads
PMM_MAX_UPLOAD_MB=25

# --- Object storage (leave empty for local disk under PMM_UPLOAD_DIR) ---
# Use the S3 API host (e.g. https://s3.wineagent.ch), not the MinIO console URL.
PMM_S3_ENDPOINT=
PMM_S3_BUCKET=
PMM_S3_ACCESS_KEY=
PMM_S3_SECRET_KEY=

# --- Reverse proxy gate (used when PMM_ENABLE_BASIC_AUTH=true in Compose) ---
REVERSE_PROXY_USER=
REVERSE_PROXY_PASSWORD=

# --- Analysis behaviour ---
PMM_AUTO_ANALYZE_ON_IMPORT=true
PMM_WORKFLOW_MAX_QA_PHOTOS=60
PMM_WORKFLOW_MAX_IMAGE_EDGE_PX=1280
PMM_WORKFLOW_TEMPERATURE=0
PMM_WORKFLOW_RETRY_INVALID_JSON=1
